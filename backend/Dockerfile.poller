FROM node:22-slim

ARG VCS_REF=unknown
ARG SOURCE_URL=https://github.com/jackwardphillips/twitcher
LABEL org.opencontainers.image.source=$SOURCE_URL \
      org.opencontainers.image.revision=$VCS_REF

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma

RUN npm ci
RUN npm exec prisma generate

COPY tsconfig.json ./
COPY src ./src

CMD ["npm", "run", "poll:prod"]
