{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/test/**/*.ts",
    "test-db-guard.d.ts",
    "test-tiers.ts",
    "vitest.*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
