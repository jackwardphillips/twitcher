// Preserved SQLite schema for the legacy dev.db fallback.
// The active application schema is schema.prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum IncidentStatus {
  OPEN
  CLOSED
  PERMANENTLY_CLOSED
}

model Sighting {
  id             Int       @id @default(autoincrement())
  species        String
  scientificName String?
  location       String
  date           DateTime
  observer       String
  rarity         Int       @default(0)
  details        String?
  mapUrl         String?
  checklistUrl   String?
  latitude       Float?
  longitude      Float?
  subId          String?
  locId          String?
  speciesCode    String?
  howMany        Int?
  displayCounty  String?
  displayState   String?
  displayCountry String?
  locationResolutionSource String?
  status         String    @default("present")
  missingSince   DateTime?
  missingPollCount Int     @default(0)
  removedAt      DateTime?
  incidentId     String?
  incident       Incident? @relation(fields: [incidentId], references: [id])
  enrichmentAttempts EnrichmentAttempt[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([removedAt])
}

model Incident {
  id                 String         @id @default(uuid())
  scientificName     String
  commonName         String
  status             IncidentStatus @default(OPEN)
  minLat             Float
  maxLat             Float
  minLng             Float
  maxLng             Float
  firstSeen          DateTime
  lastSeen           DateTime
  closedAt           DateTime?
  sightingCount      Int            @default(1)
  primaryCounty      String?
  primaryState       String?
  primaryCountry     String?
  statesCovered      String
  geminiSummary      String?
  summaryGeneratedAt DateTime?
  sightings          Sighting[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model RarityCode {
  id             Int     @id @default(autoincrement())
  commonName     String  @unique
  scientificName String? @unique
  abaCode        Int
}

model IncomingEmail {
  id        Int       @id @default(autoincrement())
  messageId String    @unique
  subject   String?
  from      String?
  date      DateTime?
  rawBody   String
  status    String    @default("new")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  attempts  EmailIngestionAttempt[]
  alertTargets AlertTarget[]
}

model IngestionRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String
  emailsFound    Int       @default(0)
  emailsIngested Int       @default(0)
  sightingsAdded Int       @default(0)
  errorMessage   String?
  trigger        String?
  emailAttempts  EmailIngestionAttempt[]
  enrichmentAttempts EnrichmentAttempt[]
  ebirdApiCallLogs EbirdApiCallLog[]

  @@index([startedAt])
}

model EmailIngestionAttempt {
  id              String    @id @default(cuid())
  ingestionRunId  String
  incomingEmailId Int?
  messageId       String
  subject         String?
  from            String?
  emailDate       DateTime?
  source          String
  status          String
  parsedSightings Int       @default(0)
  parsedSummary   String?
  errorMessage    String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  ingestionRun       IngestionRun        @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  incomingEmail      IncomingEmail?      @relation(fields: [incomingEmailId], references: [id], onDelete: SetNull)
  enrichmentAttempts EnrichmentAttempt[]

  @@index([ingestionRunId])
  @@index([incomingEmailId])
  @@index([messageId])
  @@index([status])
  @@index([startedAt])
}

model EnrichmentAttempt {
  id                   String    @id @default(cuid())
  ingestionRunId        String?
  emailAttemptId        String?
  sightingId            Int?
  species               String
  location              String
  sightingDate          DateTime
  strategy              String?
  regionCode            String?
  status                String
  rejectionReason       String?
  apiCandidateCount     Int       @default(0)
  speciesMatchCount     Int       @default(0)
  timeWindowMatchCount  Int       @default(0)
  selectedSubId         String?
  selectedSpecies       String?
  selectedLocation      String?
  selectedObsDt         String?
  errorMessage          String?
  startedAt             DateTime  @default(now())
  finishedAt            DateTime?

  ingestionRun  IngestionRun?          @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  emailAttempt  EmailIngestionAttempt? @relation(fields: [emailAttemptId], references: [id], onDelete: SetNull)
  sighting      Sighting?              @relation(fields: [sightingId], references: [id], onDelete: SetNull)
  apiCallLogs   EbirdApiCallLog[]

  @@index([ingestionRunId])
  @@index([emailAttemptId])
  @@index([sightingId])
  @@index([species])
  @@index([regionCode])
  @@index([status])
  @@index([rejectionReason])
  @@index([startedAt])
}

model EbirdApiCallLog {
  id                  String    @id @default(cuid())
  ingestionRunId       String?
  enrichmentAttemptId  String?
  endpoint             String
  paramsJson           String
  httpStatus           Int?
  durationMs           Int
  attemptNumber        Int
  maxAttempts          Int
  responseItemCount    Int?
  errorMessage         String?
  startedAt            DateTime @default(now())

  ingestionRun      IngestionRun?      @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  enrichmentAttempt EnrichmentAttempt? @relation(fields: [enrichmentAttemptId], references: [id], onDelete: SetNull)

  @@index([ingestionRunId])
  @@index([enrichmentAttemptId])
  @@index([endpoint])
  @@index([httpStatus])
  @@index([startedAt])
}

model AlertTarget {
  id                 String    @id @default(cuid())
  speciesName        String
  speciesCode        String?
  regionName         String
  regionCode         String
  expectedReports    Int       @default(0)
  status             String    @default("active")
  sourceEmailId      Int?
  firstSeenInEmailAt DateTime  @default(now())
  lastSeenInEmailAt  DateTime  @default(now())
  lastPolledAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sourceEmail IncomingEmail? @relation(fields: [sourceEmailId], references: [id], onDelete: SetNull)
  pollAttempts AlertTargetPollAttempt[]
  observations AlertTargetObservation[]

  @@unique([speciesName, regionCode])
  @@index([status])
  @@index([regionCode])
  @@index([speciesCode])
  @@index([lastSeenInEmailAt])
  @@index([lastPolledAt])
}

model AlertPollRun {
  id                       String    @id @default(cuid())
  startedAt                DateTime  @default(now())
  finishedAt               DateTime?
  status                   String
  mode                     String
  backDays                 Int       @default(3)
  targetsPolled            Int       @default(0)
  totalExpectedReports     Int       @default(0)
  totalObservationsFound   Int       @default(0)
  zeroObservationTargets   Int       @default(0)
  errorMessage             String?

  pollAttempts AlertTargetPollAttempt[]
  lastSeenObservations AlertTargetObservation[]

  @@index([startedAt])
  @@index([status])
}

model AlertTargetPollAttempt {
  id                 String    @id @default(cuid())
  alertPollRunId     String?
  alertTargetId      String
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  status             String
  speciesName        String
  speciesCode        String?
  regionName         String
  regionCode         String
  expectedReports    Int       @default(0)
  observationsFound  Int       @default(0)
  sightingsCreated   Int       @default(0)
  incidentsTouched   Int       @default(0)
  observationsMissing Int      @default(0)
  observationsRemoved Int      @default(0)
  observationsRestored Int     @default(0)
  errorMessage       String?

  alertPollRun AlertPollRun? @relation(fields: [alertPollRunId], references: [id], onDelete: Cascade)
  alertTarget AlertTarget @relation(fields: [alertTargetId], references: [id], onDelete: Cascade)

  @@index([alertPollRunId])
  @@index([alertTargetId])
  @@index([speciesName])
  @@index([regionCode])
  @@index([status])
  @@index([startedAt])
}

model AlertTargetObservation {
  id             String   @id @default(cuid())
  alertTargetId  String
  subId          String
  locId          String?
  speciesCode    String
  commonName     String
  scientificName String?
  locationName   String
  obsDt          String
  howMany        Int?
  latitude       Float?
  longitude      Float?
  displayCounty  String?
  displayState   String?
  displayCountry String?
  locationResolutionSource String?
  status         String   @default("present")
  missingSince   DateTime?
  missingPollCount Int    @default(0)
  removedAt      DateTime?
  lastSeenInPollRunId String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  alertTarget AlertTarget @relation(fields: [alertTargetId], references: [id], onDelete: Cascade)
  lastSeenInPollRun AlertPollRun? @relation(fields: [lastSeenInPollRunId], references: [id], onDelete: SetNull)

  @@unique([alertTargetId, subId])
  @@index([alertTargetId])
  @@index([speciesCode])
  @@index([subId])
  @@index([status])
  @@index([missingSince])
  @@index([removedAt])
  @@index([lastSeenInPollRunId])
  @@index([lastSeenAt])
}

model SpeciesPhoto {
  speciesName String   @id
  photoUrl    String?
  attribution String?
  fetchedAt   DateTime @default(now())
}
